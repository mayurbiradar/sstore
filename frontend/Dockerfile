FROM node:20-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
ARG VITE_API_GATEWAY_ENDPOINT
ARG VITE_STORE_EMAIL
ARG VITE_STORE_PHONE
ARG VITE_STORE_NAME
ARG VITE_STORE_ADDRESS
ARG VITE_STORE_HOURS
ARG VITE_STORE_TAGLINE
ARG VITE_STORE_PAYMENTS
ARG VITE_STORE_INSTAGRAM
ARG VITE_KEYCLOAK_URL
ARG VITE_KEYCLOAK_REALM
ARG VITE_KEYCLOAK_CLIENT_ID
ARG VITE_KEYCLOAK_GOOGLE_IDP_HINT
ARG VITE_KEYCLOAK_USE_PKCE=true
ENV VITE_API_GATEWAY_ENDPOINT=${VITE_API_GATEWAY_ENDPOINT}
ENV VITE_STORE_EMAIL=${VITE_STORE_EMAIL}
ENV VITE_STORE_PHONE=${VITE_STORE_PHONE}
ENV VITE_STORE_NAME=${VITE_STORE_NAME}
ENV VITE_STORE_ADDRESS=${VITE_STORE_ADDRESS}
ENV VITE_STORE_HOURS=${VITE_STORE_HOURS}
ENV VITE_STORE_TAGLINE=${VITE_STORE_TAGLINE}
ENV VITE_STORE_PAYMENTS=${VITE_STORE_PAYMENTS}
ENV VITE_STORE_INSTAGRAM=${VITE_STORE_INSTAGRAM}
ENV VITE_KEYCLOAK_URL=${VITE_KEYCLOAK_URL}
ENV VITE_KEYCLOAK_REALM=${VITE_KEYCLOAK_REALM}
ENV VITE_KEYCLOAK_CLIENT_ID=${VITE_KEYCLOAK_CLIENT_ID}
ENV VITE_KEYCLOAK_GOOGLE_IDP_HINT=${VITE_KEYCLOAK_GOOGLE_IDP_HINT}
ENV VITE_KEYCLOAK_USE_PKCE=${VITE_KEYCLOAK_USE_PKCE}
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
