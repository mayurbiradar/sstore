FROM node:20-alpine AS builder
WORKDIR /app
COPY package.json package-lock.json yarn.lock* ./
RUN npm ci
COPY . .
ARG VITE_API_GATEWAY_ENDPOINT
ARG VITE_EMAIL
ARG VITE_MOBILE
ARG VITE_KEYCLOAK_URL
ARG VITE_KEYCLOAK_REALM
ARG VITE_KEYCLOAK_CLIENT_ID
ARG VITE_KEYCLOAK_GOOGLE_IDP_HINT
ENV VITE_API_GATEWAY_ENDPOINT=${VITE_API_GATEWAY_ENDPOINT}
ENV VITE_EMAIL=${VITE_EMAIL}
ENV VITE_MOBILE=${VITE_MOBILE}
ENV VITE_KEYCLOAK_URL=${VITE_KEYCLOAK_URL}
ENV VITE_KEYCLOAK_REALM=${VITE_KEYCLOAK_REALM}
ENV VITE_KEYCLOAK_CLIENT_ID=${VITE_KEYCLOAK_CLIENT_ID}
ENV VITE_KEYCLOAK_GOOGLE_IDP_HINT=${VITE_KEYCLOAK_GOOGLE_IDP_HINT}
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
