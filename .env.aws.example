# SStore AWS learning deployment
# Copy this file to /home/ubuntu/.env on EC2 and replace every CHANGE_ME value.

# Public EC2 address. Update this value if the Elastic IP changes.
AWS_PUBLIC_IP=100.56.227.77
AWS_HOSTNAME=100-56-227-77.sslip.io

# PostgreSQL
POSTGRES_DB=postgres
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin

# PgAdmin
PGADMIN_DEFAULT_EMAIL=admin@sstore.com
PGADMIN_DEFAULT_PASSWORD=admin

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_HOSTNAME=https://auth.${AWS_HOSTNAME}
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=sstore
KEYCLOAK_ISSUER_URI=https://auth.${AWS_HOSTNAME}/realms/sstore
KEYCLOAK_JWK_SET_URI=http://keycloak:8080/realms/sstore/protocol/openid-connect/certs
KEYCLOAK_SSL_REQUIRED=EXTERNAL

# Keycloak frontend client
KEYCLOAK_REDIRECT_URIS=https://store.${AWS_HOSTNAME},https://store.${AWS_HOSTNAME}/*
KEYCLOAK_WEB_ORIGINS=https://store.${AWS_HOSTNAME}

# Internal Docker service URLs
PRODUCT_SERVICE_URL=http://product-service:8082
ORDER_SERVICE_URL=http://order-service:8083
PAYMENT_SERVICE_URL=http://payment-service:8084

# API gateway CORS
CORS_ALLOWED_ORIGINS=https://store.${AWS_HOSTNAME}

# Frontend values are embedded by GitHub Actions during the image build
VITE_API_GATEWAY_ENDPOINT=https://api.${AWS_HOSTNAME}
VITE_STORE_EMAIL=mr.mayurbiradar@gmail.com2
VITE_STORE_PHONE=+91 9021901050
VITE_KEYCLOAK_URL=https://auth.${AWS_HOSTNAME}
VITE_KEYCLOAK_REALM=sstore
VITE_KEYCLOAK_CLIENT_ID=sstore-frontend
VITE_KEYCLOAK_GOOGLE_IDP_HINT=google
VITE_STORE_NAME=SStore
VITE_STORE_ADDRESS=Kalewadi Pachpir Chowk, Pimpri-Chinchwad, Maharashtra 411017, India
VITE_STORE_HOURS=Monday to Friday, 9:00 AM to 6:00 PM IST
VITE_STORE_TAGLINE=Thoughtful products for everyday living, delivered with care.
VITE_STORE_PAYMENTS=UPI,Card,Net banking,COD
VITE_STORE_INSTAGRAM=https://www.instagram.com/sstore.in/

# Google Identity Provider. Leave blank to disable Google login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Razorpay
RAZORPAY_KEY_ID=CHANGE_ME_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=CHANGE_ME_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME_RAZORPAY_WEBHOOK_SECRET
RAZORPAY_CURRENCY=INR
RAZORPAY_COMPANY_NAME=SStore
