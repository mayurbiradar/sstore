FROM postgres:16-alpine

# psql is already included in the postgres image, but we add a small
# entrypoint script that creates any missing databases listed in $INIT_DATABASES.
# dockerContext is the repo root, so use the full repo-relative path.

COPY services/postgres/init/init-databases.sh /usr/local/bin/init-databases.sh
RUN chmod +x /usr/local/bin/init-databases.sh

ENTRYPOINT ["/usr/local/bin/init-databases.sh"]