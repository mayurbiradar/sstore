# Local Docker Compose configuration
# Copy this file to .env and replace sample values before running the stack.

# ---------------------------
# Database (PostgreSQL)
# Used by: postgres, product-service, order-service, payment-service
# ---------------------------
POSTGRES_DB=postgres
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin

# ---------------------------
# pgAdmin
# Used by: pgadmin
# ---------------------------
PGADMIN_DEFAULT_EMAIL=admin@sstore.com
PGADMIN_DEFAULT_PASSWORD=admin

# ---------------------------
# Keycloak
# Used by: keycloak, keycloak-bootstrap, api-gateway, product-service, order-service, payment-service
# ---------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_HOSTNAME=localhost
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=sstore
KEYCLOAK_CLIENT_ID=sstore-frontend
KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/sstore
KEYCLOAK_JWK_SET_URI=http://keycloak:8080/realms/sstore/protocol/openid-connect/certs

# Keycloak bootstrap / realm settings
KEYCLOAK_REALM_DISPLAY_NAME=Sstore Realm
KEYCLOAK_REGISTRATION_ALLOWED=true
KEYCLOAK_RESET_PASSWORD_ALLOWED=true
KEYCLOAK_REMEMBER_ME=true
KEYCLOAK_VERIFY_EMAIL=false
KEYCLOAK_REDIRECT_URIS=http://localhost,http://localhost/*,http://localhost:5173/*
KEYCLOAK_WEB_ORIGINS=http://localhost,http://localhost:5173

# ---------------------------
# Internal service URLs
# Used by: api-gateway, order-service, payment-service
# ---------------------------
PRODUCT_SERVICE_URL=http://product-service:8082
ORDER_SERVICE_URL=http://order-service:8083
PAYMENT_SERVICE_URL=http://payment-service:8084

# ---------------------------
# Frontend (Vite)
# Used by: frontend
# ---------------------------
VITE_API_GATEWAY_ENDPOINT=http://localhost:9090
VITE_STORE_EMAIL=mr.mayurbiradar@gmail.com2
VITE_STORE_PHONE=+91 9021901050
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=sstore
VITE_KEYCLOAK_CLIENT_ID=sstore-frontend
VITE_KEYCLOAK_GOOGLE_IDP_HINT=google
VITE_STORE_NAME=SStore
VITE_STORE_ADDRESS=Kalewadi Pachpir Chowk, Pimpri-Chinchwad, Maharashtra 411017, India
VITE_STORE_HOURS=Monday to Friday, 9:00 AM to 6:00 PM IST
VITE_STORE_TAGLINE=Thoughtful products for everyday living, delivered with care.
VITE_STORE_PAYMENTS=UPI,Card,Net banking,COD
VITE_STORE_INSTAGRAM=https://www.instagram.com/sstore.in/

# ---------------------------
# Google OAuth for Keycloak bootstrap
# Used by: keycloak-bootstrap
# Optional: leave blank if Google login is not configured.
# ---------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ---------------------------
# Payment provider
# Used by: payment-service
# ---------------------------
RAZORPAY_KEY_ID=test
RAZORPAY_KEY_SECRET=test
RAZORPAY_WEBHOOK_SECRET=...
RAZORPAY_CURRENCY=INR
RAZORPAY_COMPANY_NAME=SStore
