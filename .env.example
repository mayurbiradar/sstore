# Docker Compose local development configuration
# Copy this file to .env and replace credentials as needed.

POSTGRES_DB=default_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_HOSTNAME=localhost
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=sstore
KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/sstore
KEYCLOAK_JWK_SET_URI=http://keycloak:8080/realms/sstore/protocol/openid-connect/certs

PRODUCT_SERVICE_URL=http://product-service:8082
ORDER_SERVICE_URL=http://order-service:8083
PAYMENT_SERVICE_URL=http://payment-service:8084
INVENTORY_SERVICE_URL=http://inventory-service:8085
REVIEW_SERVICE_URL=http://review-service:8086

# Stripe is no longer used by the default flow. Kept here for backward-compat
# with any tooling that still references the variable; the order-service no
# longer reads it.
STRIPE_SECRET_KEY=
STRIPE_SUCCESS_URL=http://localhost/order-success
STRIPE_CANCEL_URL=http://localhost/checkout

# Razorpay test keys (https://dashboard.razorpay.com/app/keys).
# Leave blank to disable online checkout; COD will still work.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR
RAZORPAY_COMPANY_NAME=SStore

VITE_API_GATEWAY_ENDPOINT=http://localhost:9090
VITE_EMAIL=mr.mayurbiradar@gmail.com
VITE_MOBILE=+91 9021901050
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=sstore
VITE_KEYCLOAK_CLIENT_ID=sstore-frontend
VITE_KEYCLOAK_GOOGLE_IDP_HINT=google
